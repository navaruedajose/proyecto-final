<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sistema de Tickets — Backend en Spring Boot
  =====================================================================
  Este POM solo declara la ESTRUCTURA del proyecto: no hay ninguna
  dependencia de acceso a datos ni de seguridad porque la entrega
  solicitada es el esqueleto (DTOs, controladores y servicios).

  Para conectarlo de verdad a PostgreSQL y a JWT basta con descomentar
  las dependencias marcadas mas abajo. Se dejan comentadas a proposito
  para que el proyecto compile y arranque sin configuracion adicional.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.sistematickets</groupId>
    <artifactId>sistema-tickets-spring</artifactId>
    <version>1.0.0</version>
    <name>sistema-tickets-spring</name>
    <description>Backend del Sistema de Tickets (helpdesk) en Spring Boot</description>

    <properties>
        <!--
          Java 17 es el minimo que exige Spring Boot 3.x.
          OJO: en la maquina de desarrollo esta instalado Java 8, que NO
          sirve para Spring Boot 3. Hay que instalar un JDK 17 o superior
          (Temurin, Oracle, etc.). Ver docs/COMO-EJECUTAR.md.
        -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- ============================================================
             1. Web: controladores REST, Jackson, validacion
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (@Valid, @NotNull, @Size...). Habilita las
             anotaciones que ya estan puestas en todos los DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             2. Pruebas
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             3. PENDIENTES PARA LA VERSION FUNCIONAL
                Descomentar cuando se implemente la persistencia real.

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
             ============================================================ -->

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
