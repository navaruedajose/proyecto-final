# =====================================================================
# Variables de entorno del backend Spring Boot
# =====================================================================
# COMO SE USA
#   1. Copiar este archivo como .env  (el .env real esta en .gitignore)
#   2. Rellenar los valores
#   3. Cargarlos antes de arrancar
#
#       Windows (CMD):
#         for /f "usebackq tokens=1,* delims==" %i in (".env") do set "%i=%j"
#
#       Linux / macOS:
#         set -a && . ./.env && set +a
#
#   4. mvn spring-boot:run
#
# NINGUNO DE ESTOS VALORES VA AL REPOSITORIO. El .env esta ignorado a
# proposito: una credencial de base de datos o una clave JWT publicada
# en un repositorio da acceso a cualquiera.
# =====================================================================

# --- Base de datos ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=tickets_user

# Contrasena. Sin valor por defecto en el application.properties a
# proposito: si falta, la aplicacion debe fallar al arrancar en lugar de
# intentar una conexion con una clave vacia.
DB_PASSWORD=

# --- JWT -------------------------------------------------------------
# La clave de firma debe tener al menos 256 bits (32 caracteres). Se
# genera con:  openssl rand -base64 48
JWT_CLAVE=

# Tiempos de vida en milisegundos. 15 min de acceso y 7 dias de
# refresco: el acceso corto limita el dano si un token se filtra, y el
# refresco largo evita obligar al usuario a reautenticarse cada rato.
JWT_EXPIRACION_ACCESO=900000
JWT_EXPIRACION_REFRESCO=604800000

# --- Servidor --------------------------------------------------------
# 4000 coincide con el backend original en Node.js, para que el proxy
# del frontend no haya que cambiarlo.
SERVER_PORT=4000

# --- Notificaciones --------------------------------------------------
# En desarrollo se usa el proveedor simulado y no se envia nada real.
# Poner 'real' solo con credenciales de verdad.
NOTIFICACIONES_PROVEEDOR=simulado
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMS_API_CLAVE=
